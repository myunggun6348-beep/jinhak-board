rules_version = '2';
// 진학 현황판(Vercel 판) Firestore 규칙 — 학교 공용 코드 방식.
// 장부 위치(room)는 공용 코드에서 만든 40자이고, 문서는 이 컴퓨터에서 암호화된 {v, iv, c, t} 뿐이다.
// 위치를 모르면 읽을 수 없고(rooms 목록은 막힘), 내용은 코드 없이는 풀 수 없다.
// Firebase 콘솔 > Firestore Database > 규칙에 그대로 붙여넣고 게시한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/{coll}/{id} {
      function okPlace() { return room.size() == 40 && coll in ['students', 'minreq', 'meta']; }
      function okData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'c', 't']) && d.c is string && d.c.size() < 1000000
          && d.iv is string && d.iv.size() < 40;
      }
      allow get, list: if okPlace();
      allow create, update: if okPlace() && okData();
      allow delete: if okPlace();
    }
  }
}
