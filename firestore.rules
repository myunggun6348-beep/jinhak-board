rules_version = '2';
// 진학 현황판(Vercel 판) Firestore 규칙.
// OWNER_EMAIL 을 관리하는 선생님의 구글 이메일(소문자)로 바꿔 Firebase 콘솔 > Firestore > 규칙에 붙여넣는다.
// 관리 선생님은 앱의 "함께 쓰는 선생님"에서 다른 선생님 이메일을 추가·삭제한다(allowed/{이메일}).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && mail() == 'OWNER_EMAIL'; }
    function isTeacher() { return signedIn() && (isOwner() || exists(/databases/$(database)/documents/allowed/$(mail()))); }

    match /students/{id} { allow read, write: if isTeacher(); }
    match /minreq/{id}   { allow read, write: if isTeacher(); }
    match /teachers/{uid} {
      allow read: if isTeacher();
      allow write: if isTeacher() && request.auth.uid == uid;
    }
    match /allowed/{m} { allow read, write: if isOwner(); }
  }
}
